# Copy these from Firebase console > Project settings > Your apps > Web app (SDK setup).
# Put the same four values in Vercel > Project > Settings > Environment Variables.
# They are public web identifiers, not secrets. Leave them empty to run the app without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
