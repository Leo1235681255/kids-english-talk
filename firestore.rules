rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // Keep in sync with ADMIN_EMAIL in src/lib/config.ts
    function isAdmin() {
      return signedIn() && me() == 'nguyentoandinh.0511@gmail.com';
    }

    function approved() {
      return get(/databases/$(database)/documents/students/$(me())).data.status == 'approved';
    }

    // Public honor board: only a short first name and progress numbers, no email.
    match /honors/{uid} {
      allow read: if true;
      allow create: if signedIn() && uid == request.auth.uid && approved()
        && request.resource.data.keys().hasOnly(['name', 'stars', 'lessons', 'updatedAt'])
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars < 100000;
      // a child can refresh their own numbers; hiding someone from the board is admin-only
      allow update: if isAdmin() || (
        signedIn() && uid == request.auth.uid && approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'stars', 'lessons', 'updatedAt'])
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars < 100000
      );
      allow delete: if isAdmin();
    }

    match /students/{email} {
      // a student reads only their own record; the admin reads everything
      allow read: if isAdmin() || (signedIn() && email == me());
      // first sign-in: a student may only register themselves as "pending"
      allow create: if isAdmin() || (
        signedIn() && email == me()
        && request.resource.data.email == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'self'
      );
      // a student may only refresh their own device session (and name/photo); status is never theirs to change
      allow update: if isAdmin() || (
        signedIn() && email == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['session', 'name', 'photoURL'])
      );
      // approving, blocking and deleting are admin-only
      allow delete: if isAdmin();
    }
  }
}
