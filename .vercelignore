# Upload only what the web build needs (Vercel runs `npm run build` itself).
# Everything else in this folder (lesson books, photos, audio, scratch scripts) is not part of the site.
*
!.vercelignore
!index.html
!package.json
!package-lock.json
!postcss.config.js
!tailwind.config.js
!tsconfig.json
!vite.config.ts
!src
!src/**
!public
!public/**
